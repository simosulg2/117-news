# Optional for public views; required when enabling editable private schedules.
# Also enables persistent news-story history and recent Võru observations.
# The authenticated collectors and schedule feature create their required tables.
# Keep the real value in Coolify's runtime environment; never commit credentials.
DATABASE_URL=

# Optional with DATABASE_URL: protects the server-only scheduled weather collector.
# Use a random token of at least 32 bytes and keep it runtime-only and secret.
WEATHER_COLLECTOR_TOKEN=

# Optional with DATABASE_URL: protects the separate server-only news collector.
# Use a different random token of at least 32 bytes; never expose it to the browser.
NEWS_COLLECTOR_TOKEN=

# Required only for the private /ajakava section. Create a GitHub OAuth app
# whose production callback is https://117.ee/api/auth/callback/github.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true

# Production only: public site origin used after OAuth returns through a reverse
# proxy. Leave blank for local development; set to https://117.ee in Coolify.
AUTH_URL=

# The immutable numeric GitHub account ID bootstrapped as the schedule owner.
# The owner can issue one-time invitations to additional accounts in /ajakava.
SCHEDULE_ALLOWED_GITHUB_ID=

# Base64url-encoded 32-byte key used to decrypt data/schedule.enc.json on the
# server. Keep it separate from AUTH_SECRET and never expose it to the browser.
SCHEDULE_DATA_KEY=
