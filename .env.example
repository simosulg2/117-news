# Optional: enables persistent news-story history and collection of recent Võru
# station observations. Their authenticated collectors create the required tables.
# Keep the real value in Coolify's runtime environment; never commit credentials.
DATABASE_URL=

# Optional with DATABASE_URL: protects the server-only scheduled weather collector.
# Use a random token of at least 32 bytes and keep it runtime-only and secret.
WEATHER_COLLECTOR_TOKEN=

# Optional with DATABASE_URL: protects the separate server-only news collector.
# Use a different random token of at least 32 bytes; never expose it to the browser.
NEWS_COLLECTOR_TOKEN=
